local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local CleanUI = {}
CleanUI.__index = CleanUI

function CleanUI.new(userConfig)
    local self = setmetatable({}, CleanUI)
    
    -- Cấu hình mặc định & tùy chỉnh từ người dùng
    self.Config = userConfig or {}
    self.Title = self.Config.Title or "Settings"
    self.MenuKey = self.Config.MenuKey or Enum.KeyCode.RightControl
    
    -- Bảng màu (Hỗ trợ tùy chỉnh Accent Color)
    self.C = {
        MainBg     = Color3.fromRGB(16, 16, 18),
        HeaderLine = Color3.fromRGB(32, 32, 36),
        CardBg     = Color3.fromRGB(22, 22, 25),
        CardBorder = Color3.fromRGB(38, 38, 42),
        AccentBlue = self.Config.AccentColor or Color3.fromRGB(10, 132, 255),
        ToggleOff  = Color3.fromRGB(38, 38, 42),
        TextWhite  = Color3.fromRGB(255, 255, 255),
        TextGray   = Color3.fromRGB(130, 130, 135),
        TabActive  = Color3.fromRGB(30, 30, 34),
        Danger     = Color3.fromRGB(255, 90, 90),
        DangerBg   = Color3.fromRGB(50, 20, 20),
    }

    self.Connections = {}
    self.Tabs = {}
    self.IsMenuOpen = true
    self.ToggleMenuFunc = nil

    self:BuildUI()
    return self
end

function CleanUI:Track(connection)
    table.insert(self.Connections, connection)
    return connection
end

function CleanUI:BuildUI()
    local C = self.C

    if PlayerGui:FindFirstChild("CleanUI_Module") then
        PlayerGui.CleanUI_Module:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "CleanUI_Module"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.Parent = PlayerGui
    self.ScreenGui = ScreenGui

    ScreenGui.Destroying:Connect(function()
        for _, conn in ipairs(self.Connections) do
            if conn.Connected then conn:Disconnect() end
        end
        table.clear(self.Connections)
    end)

    -- ===== Main Frame =====
    local MainFrame = Instance.new("Frame")
    MainFrame.Name = "MainFrame"
    MainFrame.Size = UDim2.new(0.85, 0, 0.6, 0)
    MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    MainFrame.BackgroundColor3 = C.MainBg
    MainFrame.BorderSizePixel = 0
    MainFrame.ClipsDescendants = true
    MainFrame.Parent = ScreenGui
    self.MainFrame = MainFrame

    local MainSizeConstraint = Instance.new("UISizeConstraint", MainFrame)
    MainSizeConstraint.MinSize = Vector2.new(300, 240)
    MainSizeConstraint.MaxSize = Vector2.new(440, 290)

