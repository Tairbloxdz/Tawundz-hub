    local CloseIcon = Instance.new("TextLabel", CloseBtn)
    CloseIcon.Size = UDim2.new(1, 0, 1, 0)
    CloseIcon.BackgroundTransparency = 1
    CloseIcon.Text = "×"
    CloseIcon.Font = Enum.Font.GothamBold
    CloseIcon.TextSize = 15
    CloseIcon.TextColor3 = C.TextGray

    CloseBtn.MouseEnter:Connect(function()
        TweenService:Create(CloseBtn, TweenInfo.new(0.12), {BackgroundColor3 = C.DangerBg}):Play()
        TweenService:Create(CloseIcon, TweenInfo.new(0.12), {TextColor3 = C.Danger}):Play()
