    VerticalDivider.Size = UDim2.new(0, 1, 1, -39)
    VerticalDivider.Position = UDim2.new(0.32, 0, 0, 39)
    VerticalDivider.BackgroundColor3 = C.HeaderLine
    VerticalDivider.BorderSizePixel = 0
    VerticalDivider.Parent = MainFrame

    local ContentArea = Instance.new("Frame")
    ContentArea.Size = UDim2.new(0.68, -10, 1, -48)
    ContentArea.Position = UDim2.new(0.32, 6, 0, 43)
    ContentArea.BackgroundTransparency = 1
    ContentArea.ClipsDescendants = true
    ContentArea.Parent = MainFrame
    self.ContentArea = ContentArea
    self.Sidebar = Sidebar

    -- Floating Toggle Button
    local FloatBtn = Instance.new("TextButton", ScreenGui)
    FloatBtn.Name = "FloatingToggle"
    FloatBtn.Size = UDim2.new(0, 48, 0, 30)
    FloatBtn.AnchorPoint = Vector2.new(1, 1)
    FloatBtn.Position = UDim2.new(1, -20, 1, -170)
    FloatBtn.BackgroundColor3 = C.MainBg
    FloatBtn.Text = ""
    FloatBtn.AutoButtonColor = false
    Instance.new("UICorner", FloatBtn).CornerRadius = UDim.new(0, 8)

    local FloatScale = Instance.new("UIScale", FloatBtn)
    local FloatStroke = Instance.new("UIStroke", FloatBtn)
    FloatStroke.Color = C.AccentBlue
    FloatStroke.Thickness = 1.5

    local FloatText = Instance.new("TextLabel", FloatBtn)
    FloatText.Size = UDim2.new(1, 0, 1, 0)
    FloatText.BackgroundTransparency = 1
    FloatText.Font = Enum.Font.GothamBold
    FloatText.TextSize = 11
    FloatText.TextColor3 = C.TextWhite
    FloatText.Text = "OFF"

    FloatBtn.MouseEnter:Connect(function()
        TweenService:Create(FloatBtn, TweenInfo.new(0.12), {BackgroundColor3 = C.CardBg}):Play()
    end)
    FloatBtn.MouseLeave:Connect(function()
        TweenService:Create(FloatBtn, TweenInfo.new(0.15), {BackgroundColor3 = C.MainBg}):Play()
    end)

    local function toggleMenu()
        self.IsMenuOpen = not self.IsMenuOpen
        if self.IsMenuOpen then
            MainFrame.Visible = true
            MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
            MainScale.Scale = 0
            FloatText.Text = "OFF"
            TweenService:Create(FloatStroke, TweenInfo.new(0.2), {Color = C.AccentBlue}):Play()
            TweenService:Create(MainScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        else
            FloatText.Text = "ON"
            TweenService:Create(FloatStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(100, 100, 105)}):Play()
            local scaleTween = TweenService:Create(MainScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Scale = 0})
            scaleTween:Play()
            scaleTween.Completed:Connect(function()
                if not self.IsMenuOpen then MainFrame.Visible = false end
            end)
        end
    end
    self.ToggleMenuFunc = toggleMenu

    FloatBtn.MouseButton1Click:Connect(toggleMenu)

    self:MakeDraggable(MainFrame, Header, false)
    self:MakeDraggable(FloatBtn, FloatBtn, true, toggleMenu)

    self:Track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == self.MenuKey then
            toggleMenu()
        end
    end))
end

-- ===== Scroll Reveal Hiệu ứng =====
local function attachScrollReveal(page, cardBgColor)
    local revealed = {}
    local function reveal()
        local pageAbsY = page.AbsolutePosition.Y
        local pageHeight = page.AbsoluteSize.Y
        for _, card in ipairs(page:GetChildren()) do
            if card:IsA("Frame") and not revealed[card] then
                local mask = card:FindFirstChild("RevealMask")
                if mask then
                    local relY = card.AbsolutePosition.Y - pageAbsY
                    if relY < pageHeight + 24 and relY > -60 then
                        revealed[card] = true
                        local tween = TweenService:Create(mask, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1})
                        tween:Play()
                        tween.Completed:Connect(function()
                            if mask and mask.Parent then mask:Destroy() end
                        end)
                    end
                end
            end
        end
    end
    page:GetPropertyChangedSignal("CanvasPosition"):Connect(reveal)
    page:GetPropertyChangedSignal("Visible"):Connect(function()
        if page.Visible then task.defer(reveal) end
    end)
end

-- ===== Tạo Tab =====
function CleanUI:AddTab(name, iconId)
    local C = self.C
    local Sidebar = self.Sidebar
    local ContentArea = self.ContentArea

    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(1, 0, 0, 30)
    TabBtn.BackgroundColor3 = C.MainBg
    TabBtn.AutoButtonColor = false
    TabBtn.Text = ""
    TabBtn.Parent = Sidebar
    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

    local Indicator = Instance.new("Frame", TabBtn)
    Indicator.Size = UDim2.new(0, 3, 0, 14)
    Indicator.Position = UDim2.new(0, 0, 0.5, -7)
    Indicator.BackgroundColor3 = C.AccentBlue
    Indicator.BackgroundTransparency = 1
    Instance.new("UICorner", Indicator).CornerRadius = UDim.new(1, 0)

    local Icon = Instance.new("ImageLabel", TabBtn)
    Icon.Size = UDim2.new(0, 15, 0, 15)
    Icon.Position = UDim2.new(0, 10, 0.5, -7)
    Icon.Image = iconId or ""
    Icon.ImageColor3 = C.TextGray
    Icon.BackgroundTransparency = 1

    local Label = Instance.new("TextLabel", TabBtn)
    Label.Text = name
    Label.Font = Enum.Font.GothamMedium
    Label.TextSize = 11
    Label.TextColor3 = C.TextGray
    Label.Position = UDim2.new(0, 32, 0, 0)
    Label.Size = UDim2.new(1, -34, 1, 0)
    Label.BackgroundTransparency = 1
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local Page = Instance.new("ScrollingFrame")
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.Visible = false
    Page.ClipsDescendants = true
    Page.ScrollBarThickness = 2
    Page.ScrollBarImageColor3 = C.CardBorder
    Page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Page.CanvasSize = UDim2.new(0, 0, 0, 0)
    Page.ElasticBehavior = Enum.ElasticBehavior.Always
    Page.ScrollingDirection = Enum.ScrollingDirection.Y
    Page.Parent = ContentArea

    attachScrollReveal(Page, C.CardBg)

    local PageList = Instance.new("UIListLayout", Page)
    PageList.Padding = UDim.new(0, 6)
    PageList.SortOrder = Enum.SortOrder.LayoutOrder

    local PagePadding = Instance.new("UIPadding", Page)
    PagePadding.PaddingTop = UDim.new(0, 2)
    PagePadding.PaddingBottom = UDim.new(0, 8)
    PagePadding.PaddingLeft = UDim.new(0, 2)
    PagePadding.PaddingRight = UDim.new(0, 6)

    local isActive = false

    TabBtn.MouseEnter:Connect(function()
        if isActive then return end
        TweenService:Create(TabBtn, TweenInfo.new(0.15), {BackgroundColor3 = C.CardBg}):Play()
        TweenService:Create(Label, TweenInfo.new(0.15), {TextColor3 = C.TextWhite}):Play()
    end)

    TabBtn.MouseLeave:Connect(function()
        if isActive then return end
        TweenService:Create(TabBtn, TweenInfo.new(0.15), {BackgroundColor3 = C.MainBg}):Play()
        TweenService:Create(Label, TweenInfo.new(0.15), {TextColor3 = C.TextGray}):Play()
    end)

    TabBtn.MouseButton1Click:Connect(function()
        for _, t in ipairs(self.Tabs) do
            t.SetActive(false)
            TweenService:Create(t.Btn, TweenInfo.new(0.2), {BackgroundColor3 = C.MainBg}):Play()
            TweenService:Create(t.Indicator, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
            TweenService:Create(t.Icon, TweenInfo.new(0.2), {ImageColor3 = C.TextGray}):Play()
            TweenService:Create(t.Label, TweenInfo.new(0.2), {TextColor3 = C.TextGray}):Play()
            t.Page.Visible = false
        end
        isActive = true
        TweenService:Create(TabBtn, TweenInfo.new(0.2), {BackgroundColor3 = C.TabActive}):Play()
        TweenService:Create(Indicator, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
        TweenService:Create(Icon, TweenInfo.new(0.2), {ImageColor3 = C.TextWhite}):Play()
        TweenService:Create(Label, TweenInfo.new(0.2), {TextColor3 = C.TextWhite}):Play()
        Page.Visible = true
    end)

    local tabObj = {
        Btn = TabBtn, Indicator = Indicator, Icon = Icon, Label = Label, Page = Page,
        SetActive = function(active) isActive = active end
    }
    table.insert(self.Tabs, tabObj)

    -- Mặc định mở tab đầu tiên
    if #self.Tabs == 1 then
        tabObj.SetActive(true)
        TabBtn.BackgroundColor3 = C.TabActive
        Indicator.BackgroundTransparency = 0
        Icon.ImageColor3 = C.TextWhite
        Label.TextColor3 = C.TextWhite
        Page.Visible = true
    end

    return tabObj
end

