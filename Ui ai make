-- ===== Slider =====
function CleanUI:AddSlider(page, name, min, max, default, callback)
    local C = self.C
    local Card = createBaseCard(page, 46, C)

    local Title = Instance.new("TextLabel", Card)
    Title.Text = name
    Title.Font = Enum.Font.GothamMedium
    Title.TextSize = 11
    Title.TextColor3 = C.TextWhite
    Title.Position = UDim2.new(0, 10, 0, 6)
    Title.Size = UDim2.new(0, 140, 0, 14)
    Title.BackgroundTransparency = 1
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local ValLabel = Instance.new("TextLabel", Card)
    ValLabel.Text = tostring(default)
    ValLabel.Font = Enum.Font.GothamMedium
    ValLabel.TextSize = 11
    ValLabel.TextColor3 = C.TextWhite
    ValLabel.Position = UDim2.new(1, -50, 0, 6)
    ValLabel.Size = UDim2.new(0, 40, 0, 14)
    ValLabel.BackgroundTransparency = 1
    ValLabel.TextXAlignment = Enum.TextXAlignment.Right

    local Track = Instance.new("Frame", Card)
    Track.Size = UDim2.new(1, -20, 0, 4)
    Track.Position = UDim2.new(0, 10, 0, 30)
    Track.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    Track.BorderSizePixel = 0
    Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

    local startScale = (default - min) / math.max((max - min), 1)

    local Fill = Instance.new("Frame", Track)
    Fill.Size = UDim2.new(startScale, 0, 1, 0)
    Fill.BackgroundColor3 = C.AccentBlue
    Fill.BorderSizePixel = 0
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

    local Thumb = Instance.new("Frame", Track)
    Thumb.Size = UDim2.new(0, 14, 0, 14)
    Thumb.AnchorPoint = Vector2.new(0.5, 0.5)
    Thumb.Position = UDim2.new(startScale, 0, 0.5, 0)
    Thumb.BackgroundColor3 = C.TextWhite
    Thumb.BorderSizePixel = 0
    Thumb.ZIndex = 2
    Instance.new("UICorner", Thumb).CornerRadius = UDim.new(1, 0)

    local dragging = false
    local function update(input)
        if Track.AbsoluteSize.X == 0 then return end
        local delta = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * delta)
        Fill.Size = UDim2.new(delta, 0, 1, 0)
        Thumb.Position = UDim2.new(delta, 0, 0.5, 0)
        ValLabel.Text = tostring(val)
        if callback then callback(val) end
    end

    Track.MouseEnter:Connect(function()
        TweenService:Create(Thumb, TweenInfo.new(0.12), {Size = UDim2.new(0, 16, 0, 16)}):Play()
    end)
    Track.MouseLeave:Connect(function()
        if not dragging then
            TweenService:Create(Thumb, TweenInfo.new(0.12), {Size = UDim2.new(0, 14, 0, 14)}):Play()
        end
    end)

    Track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            TweenService:Create(Thumb, TweenInfo.new(0.1), {Size = UDim2.new(0, 18, 0, 18)}):Play()
            update(input)
        end
    end)

    self:Track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                TweenService:Create(Thumb, TweenInfo.new(0.12), {Size = UDim2.new(0, 14, 0, 14)}):Play()
            end
            dragging = false
        end
    end))

    self:Track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end))
end

-- ===== Toggle =====
function CleanUI:AddToggle(page, name, default, callback)
    local C = self.C
    local Card = createBaseCard(page, 36, C)
    local state = default or false

    local Title = Instance.new("TextLabel", Card)
    Title.Text = name
    Title.Font = Enum.Font.GothamMedium
    Title.TextSize = 11
    Title.TextColor3 = C.TextWhite
    Title.Position = UDim2.new(0, 10, 0, 0)
    Title.Size = UDim2.new(1, -50, 1, 0)
    Title.BackgroundTransparency = 1
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local Switch = Instance.new("TextButton", Card)
    Switch.Size = UDim2.new(0, 40, 0, 22)
    Switch.Position = UDim2.new(1, -48, 0.5, -11)
    Switch.BackgroundColor3 = state and C.AccentBlue or C.ToggleOff
    Switch.Text = ""
    Switch.AutoButtonColor = false
    Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)

    local SwitchStroke = Instance.new("UIStroke", Switch)
    SwitchStroke.Color = state and C.AccentBlue or C.CardBorder
    SwitchStroke.Thickness = 1
    SwitchStroke.Transparency = 0.4

    local Knob = Instance.new("Frame", Switch)
    Knob.Size = UDim2.new(0, 16, 0, 16)
    Knob.Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    Knob.BackgroundColor3 = C.TextWhite
    Knob.BorderSizePixel = 0
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    local function refresh(animated)
        local targetPos = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        local targetBg = state and C.AccentBlue or C.ToggleOff
        local targetStroke = state and C.AccentBlue or C.CardBorder
        local t = animated and TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out) or TweenInfo.new(0)
        TweenService:Create(Knob, t, {Position = targetPos}):Play()
        TweenService:Create(Switch, t, {BackgroundColor3 = targetBg}):Play()
        TweenService:Create(SwitchStroke, t, {Color = targetStroke}):Play()
    end

    Switch.MouseEnter:Connect(function()
        TweenService:Create(Knob, TweenInfo.new(0.12), {Size = UDim2.new(0, 18, 0, 18)}):Play()
    end)
    Switch.MouseLeave:Connect(function()
        TweenService:Create(Knob, TweenInfo.new(0.12), {Size = UDim2.new(0, 16, 0, 16)}):Play()
    end)

    Switch.MouseButton1Click:Connect(function()
        state = not state
        refresh(true)
        if callback then callback(state) end
    end)
end

