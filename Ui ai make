function CleanUI:AddKeybind(page, name, defaultKey, callback)
    local C = self.C
    local Card = createBaseCard(page, 36, C)
    local currentKey = defaultKey or Enum.KeyCode.F
    local listening = false

    local Title = Instance.new("TextLabel", Card)
    Title.Text = name
    Title.Font = Enum.Font.GothamMedium
    Title.TextSize = 11
    Title.TextColor3 = C.TextWhite
    Title.Position = UDim2.new(0, 10, 0, 0)
    Title.Size = UDim2.new(1, -80, 1, 0)
    Title.BackgroundTransparency = 1
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local KeyBtn = Instance.new("TextButton", Card)
    KeyBtn.Size = UDim2.new(0, 62, 0, 24)
    KeyBtn.Position = UDim2.new(1, -70, 0.5, -12)
    KeyBtn.BackgroundColor3 = Color3.fromRGB(16, 16, 18)
    KeyBtn.Text = ""
    KeyBtn.AutoButtonColor = false
    Instance.new("UICorner", KeyBtn).CornerRadius = UDim.new(1, 0)

    local KeyStroke = Instance.new("UIStroke", KeyBtn)
    KeyStroke.Color = C.CardBorder
    KeyStroke.Thickness = 1

    local KeyLabel = Instance.new("TextLabel", KeyBtn)
    KeyLabel.Size = UDim2.new(1, -16, 1, 0)
    KeyLabel.Position = UDim2.new(0, 6, 0, 0)
    KeyLabel.BackgroundTransparency = 1
    KeyLabel.Text = currentKey.Name
    KeyLabel.TextColor3 = C.TextWhite
    KeyLabel.Font = Enum.Font.GothamBold
    KeyLabel.TextSize = 10
    KeyLabel.TextXAlignment = Enum.TextXAlignment.Center

    local RecDot = Instance.new("Frame", KeyBtn)
    RecDot.Size = UDim2.new(0, 6, 0, 6)
    RecDot.AnchorPoint = Vector2.new(1, 0.5)
    RecDot.Position = UDim2.new(1, -7, 0.5, 0)
    RecDot.BackgroundColor3 = C.Danger
    RecDot.BackgroundTransparency = 1
    RecDot.BorderSizePixel = 0
    Instance.new("UICorner", RecDot).CornerRadius = UDim.new(1, 0)

    KeyBtn.MouseButton1Click:Connect(function()
        listening = true
        KeyLabel.Text = "..."
        TweenService:Create(KeyStroke, TweenInfo.new(0.15), {Color = C.AccentBlue, Thickness = 1.5}):Play()
        task.spawn(function()
            local on = true
            while listening and KeyBtn.Parent do
                TweenService:Create(RecDot, TweenInfo.new(0.5), {BackgroundTransparency = on and 0 or 1}):Play()
                on = not on
                task.wait(0.5)
            end
            RecDot.BackgroundTransparency = 1
        end)
    end)

    self:Track(UserInputService.InputBegan:Connect(function(input)
        if listening and input.UserInputType == Enum.UserInputType.Keyboard then
            listening = false
            if input.KeyCode ~= Enum.KeyCode.Escape then
                currentKey = input.KeyCode
                if callback then callback(currentKey) end
            end
            KeyLabel.Text = currentKey.Name
            TweenService:Create(KeyStroke, TweenInfo.new(0.15), {Color = C.CardBorder, Thickness = 1}):Play()
        end
    end))
end

-- ===== Button =====
function CleanUI:AddButton(page, name, callback, isDanger)
    local C = self.C
    local Card = createBaseCard(page, 36, C)
    Card.ClipsDescendants = true

    local CardScale = Instance.new("UIScale", Card)
    local textColor = isDanger and C.Danger or C.TextWhite

    local Btn = Instance.new("TextButton", Card)
    Btn.Size = UDim2.new(1, 0, 1, 0)
    Btn.BackgroundTransparency = 1
    Btn.Text = name
    Btn.Font = Enum.Font.GothamMedium
    Btn.TextSize = 11
    Btn.TextColor3 = textColor
    Btn.AutoButtonColor = false

    local hoverColor = isDanger and Color3.fromRGB(35, 20, 20) or Color3.fromRGB(30, 30, 34)
    local pressColor = isDanger and Color3.fromRGB(45, 22, 22) or Color3.fromRGB(38, 38, 43)

    Btn.MouseEnter:Connect(function()
        TweenService:Create(Card, TweenInfo.new(0.12), {BackgroundColor3 = hoverColor}):Play()
    end)
    Btn.MouseLeave:Connect(function()
        TweenService:Create(Card, TweenInfo.new(0.15), {BackgroundColor3 = C.CardBg}):Play()
    end)
    Btn.MouseButton1Down:Connect(function()
        TweenService:Create(Card, TweenInfo.new(0.08), {BackgroundColor3 = pressColor}):Play()
        TweenService:Create(CardScale, TweenInfo.new(0.08), {Scale = 0.97}):Play()
    end)
    Btn.MouseButton1Up:Connect(function()
        TweenService:Create(Card, TweenInfo.new(0.1), {BackgroundColor3 = hoverColor}):Play()
        TweenService:Create(CardScale, TweenInfo.new(0.18), {Scale = 1}):Play()
    end)
    Btn.MouseButton1Click:Connect(function()
        if callback then callback() end
    end)
end

