function CleanUI:AddDropdown(page, name, options, defaultOption, callback)
    local C = self.C
    local Card = createBaseCard(page, 36, C)
    local currentOption = defaultOption or options[1] or "Chọn..."

    local Title = Instance.new("TextLabel", Card)
    Title.Text = name
    Title.Font = Enum.Font.GothamMedium
    Title.TextSize = 11
    Title.TextColor3 = C.TextWhite
    Title.Position = UDim2.new(0, 10, 0, 0)
    Title.Size = UDim2.new(0, 100, 1, 0)
    Title.BackgroundTransparency = 1
    Title.TextXAlignment = Enum.TextXAlignment.Left

    local Box = Instance.new("TextButton", Card)
    Box.Size = UDim2.new(0, 110, 0, 22)
    Box.Position = UDim2.new(1, -118, 0.5, -11)
    Box.BackgroundColor3 = Color3.fromRGB(16, 16, 18)
    Box.AutoButtonColor = false
    Box.Text = ""
    Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 4)

    local BoxStroke = Instance.new("UIStroke", Box)
    BoxStroke.Color = C.CardBorder
    BoxStroke.Thickness = 1

    local SelectedLabel = Instance.new("TextLabel", Box)
    SelectedLabel.Size = UDim2.new(1, -22, 1, 0)
    SelectedLabel.Position = UDim2.new(0, 8, 0, 0)
    SelectedLabel.BackgroundTransparency = 1
    SelectedLabel.Text = currentOption
    SelectedLabel.TextColor3 = C.TextWhite
    SelectedLabel.Font = Enum.Font.GothamMedium
    SelectedLabel.TextSize = 10
    SelectedLabel.TextXAlignment = Enum.TextXAlignment.Left

    local Arrow = Instance.new("TextLabel", Box)
    Arrow.Size = UDim2.new(0, 16, 1, 0)
    Arrow.Position = UDim2.new(1, -18, 0, 0)
    Arrow.BackgroundTransparency = 1
    Arrow.Text = "▾"
    Arrow.TextColor3 = C.TextGray
    Arrow.Font = Enum.Font.GothamBold
    Arrow.TextSize = 10

    local List = Instance.new("Frame")
    List.BackgroundColor3 = Color3.fromRGB(20, 20, 23)
    List.BorderSizePixel = 0
    List.Visible = false
    List.ZIndex = 50
    List.ClipsDescendants = true
    List.Parent = self.ScreenGui
    Instance.new("UICorner", List).CornerRadius = UDim.new(0, 6)

    local ListStroke = Instance.new("UIStroke", List)
    ListStroke.Color = C.AccentBlue
    ListStroke.Thickness = 1

    local ListScale = Instance.new("UIScale", List)
    ListScale.Scale = 0.9

    local Scroller = Instance.new("ScrollingFrame", List)
    Scroller.Size = UDim2.new(1, 0, 1, 0)
    Scroller.BackgroundTransparency = 1
    Scroller.ZIndex = 51
    Scroller.ScrollBarThickness = 2
    Scroller.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Scroller.CanvasSize = UDim2.new(0, 0, 0, 0)

    local ScrollerList = Instance.new("UIListLayout", Scroller)
    ScrollerList.Padding = UDim.new(0, 2)

    local isOpen = false
    local function closeList()
        if not isOpen then return end
        isOpen = false
        TweenService:Create(ListScale, TweenInfo.new(0.12), {Scale = 0.9}):Play()
        TweenService:Create(Arrow, TweenInfo.new(0.15), {Rotation = 0}):Play()
        task.delay(0.12, function()
            if not isOpen then List.Visible = false end
        end)
    end

    local function openList()
        for _, child in ipairs(Scroller:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end

        for _, opt in ipairs(options) do
            local Item = Instance.new("TextButton")
            Item.Size = UDim2.new(1, 0, 0, 24)
            Item.BackgroundColor3 = Color3.fromRGB(20, 20, 23)
            Item.AutoButtonColor = false
            Item.Text = opt
            Item.Font = Enum.Font.GothamMedium
            Item.TextSize = 10
            Item.TextColor3 = C.TextWhite
            Item.ZIndex = 52
            Item.Parent = Scroller
            Instance.new("UICorner", Item).CornerRadius = UDim.new(0, 4)

            Item.MouseButton1Click:Connect(function()
                currentOption = opt
                SelectedLabel.Text = opt
                closeList()
                if callback then callback(opt) end
            end)
        end

        local abs, size = Box.AbsolutePosition, Box.AbsoluteSize
        List.Position = UDim2.new(0, abs.X, 0, abs.Y + size.Y + 4)
        List.Size = UDim2.new(0, size.X, 0, math.min(#options * 26 + 8, 150))
        List.Visible = true
        isOpen = true
        TweenService:Create(Arrow, TweenInfo.new(0.15), {Rotation = 180}):Play()
        TweenService:Create(ListScale, TweenInfo.new(0.18), {Scale = 1}):Play()
    end

    Box.MouseButton1Click:Connect(function()
        if isOpen then closeList() else openList() end
    end)
end

-- ===== Trợ giúp Kéo thả cửa sổ =====
function CleanUI:MakeDraggable(frame, handle, isButton, onClick)
    handle = handle or frame
    local dragging, dragInput, dragStart, startPos, hasMoved = false, nil, nil, nil, false

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            hasMoved = false
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if isButton and not hasMoved and onClick then onClick() end
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    self:Track(UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            if delta.Magnitude > 3 then hasMoved = true end
            local targetPos = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            TweenService:Create(frame, TweenInfo.new(0.04), {Position = targetPos}):Play()
        end
    end))
end

return CleanUI
